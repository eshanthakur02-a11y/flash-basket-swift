# ============================================================
# AP Mart — environment variables
# Copy to .env and fill in values from YOUR Supabase project
# (Project Settings -> API) when running outside Lovable.
# ============================================================

# --- Browser (required) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or anon JWT key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# --- Server-side (required for server functions / webhooks) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=...                       # secret — never expose to browser

# --- Google Maps (connector-managed on Lovable; your own key outside) ---
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_API_KEY=

# --- OneSignal push notifications (optional) ---
VITE_ONESIGNAL_APP_ID=
# The REST API key lives in the app_config table (key: onesignal_rest_api_key), not here.

# --- Razorpay payments (optional; webhook signature verification) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Super Admin bootstrap (used once by the provisioning endpoint) ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
